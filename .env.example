# JSON webhook that receives enquiry + newsletter submissions (Formspree, Make, Zapier, Apps Script…).
# Leave empty to show visitors a "please email/call us" message instead.
FORM_WEBHOOK_URL=

# Set to "true" at BUILD time on non-Vercel production hosts so robots.txt allows indexing.
# (On Vercel, production is detected automatically via VERCEL_ENV.)
SITE_INDEXING=
